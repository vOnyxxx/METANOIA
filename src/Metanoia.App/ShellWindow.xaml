<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Metanoia.App.ViewModels" xmlns:views="clr-namespace:Metanoia.App.Views" xmlns:c="clr-namespace:Metanoia.App.Controls" x:Class="Metanoia.App.ShellWindow" Title="METANOIA" Width="1480" Height="920" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen" Background="Transparent" Foreground="{StaticResource WhiteBrush}" FontFamily="{StaticResource InterfaceFont}" AllowDrop="True" PreviewDragOver="OnPreviewDragOver" Drop="OnDrop">
    <Grid Background="{StaticResource BackdropBrush}" ClipToBounds="True">
        <Ellipse Width="800" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-350,-340,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#285ACDBD"/>
                    <GradientStop Color="#005ACDBD" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="900" Height="700" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-420,-350" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#259CCC4A"/>
                    <GradientStop Color="#009CCC4A" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource GlassCard}" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/Logo%20METANOIA.png" Width="34" Height="28"/>
                        <TextBlock Text="METANOIA" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,26,0"/>
                        <Button Content="Inicio" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppSection.Home}" Margin="3,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:AppSection.Home}">
                                            <Setter Property="Foreground" Value="{StaticResource AcidLimeBrush}"/>
                                            <Setter Property="Background" Value="#283C4527"/>
                                            <Setter Property="BorderBrush" Value="#6088B04A"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Imagen" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppSection.Image}" Margin="3,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:AppSection.Image}">
                                            <Setter Property="Foreground" Value="{StaticResource AcidLimeBrush}"/>
                                            <Setter Property="Background" Value="#283C4527"/>
                                            <Setter Property="BorderBrush" Value="#6088B04A"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Video" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppSection.Video}" Margin="3,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:AppSection.Video}">
                                            <Setter Property="Foreground" Value="{StaticResource AcidLimeBrush}"/>
                                            <Setter Property="Background" Value="#283C4527"/>
                                            <Setter Property="BorderBrush" Value="#6088B04A"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Audio" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppSection.Audio}" Margin="3,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:AppSection.Audio}">
                                            <Setter Property="Foreground" Value="{StaticResource AcidLimeBrush}"/>
                                            <Setter Property="Background" Value="#283C4527"/>
                                            <Setter Property="BorderBrush" Value="#6088B04A"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="●" Foreground="{StaticResource AcidLimeBrush}" FontSize="9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="FFmpeg" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" ToolTip="{Binding ToolStatusText}" Margin="0,0,20,0"/>
                        <Button Content="Avanzado" Command="{Binding NavigateCommand}" Style="{StaticResource NavButton}" CommandParameter="{x:Static vm:AppSection.Advanced}" Margin="0,0,10,0"/>
                        <Button Content="＋ Nuevo proceso" Command="{Binding SelectFileCommand}" Style="{StaticResource CompactButton}" MinHeight="36"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="0,20,0,20">
                <views:HomeView>
                    <views:HomeView.Style>
                        <Style TargetType="views:HomeView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="c:Motion.Enabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:AppSection.Home}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:HomeView.Style>
                </views:HomeView>
                <views:ImageWorkspaceView>
                    <views:ImageWorkspaceView.Style>
                        <Style TargetType="views:ImageWorkspaceView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="c:Motion.Enabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:AppSection.Image}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ImageWorkspaceView.Style>
                </views:ImageWorkspaceView>
                <views:VideoWorkspaceView>
                    <views:VideoWorkspaceView.Style>
                        <Style TargetType="views:VideoWorkspaceView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="c:Motion.Enabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:AppSection.Video}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:VideoWorkspaceView.Style>
                </views:VideoWorkspaceView>
                <views:AudioWorkspaceView>
                    <views:AudioWorkspaceView.Style>
                        <Style TargetType="views:AudioWorkspaceView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="c:Motion.Enabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:AppSection.Audio}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:AudioWorkspaceView.Style>
                </views:AudioWorkspaceView>
                <views:AdvancedWorkspaceView>
                    <views:AdvancedWorkspaceView.Style>
                        <Style TargetType="views:AdvancedWorkspaceView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="c:Motion.Enabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:AppSection.Advanced}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:AdvancedWorkspaceView.Style>
                </views:AdvancedWorkspaceView>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding QueueSummary}" FontSize="10" Foreground="{StaticResource FogBrush}" VerticalAlignment="Center" Margin="0,0,22,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <ProgressBar Grid.Column="2" Value="{Binding ProgressPercent}" Height="4" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource NavButton}" Margin="18,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
