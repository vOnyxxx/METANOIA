<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ObsidianColor">#0A0C0F</Color>
    <Color x:Key="GraphiteColor">#191D22</Color>
    <Color x:Key="GraphiteRaisedColor">#272F35</Color>
    <Color x:Key="AcidLimeColor">#C6FF4D</Color>
    <Color x:Key="ElectricCyanColor">#72DCE8</Color>
    <SolidColorBrush x:Key="ObsidianBrush" Color="#C00A0C0F"/>
    <SolidColorBrush x:Key="GraphiteBrush" Color="#D0191D22"/>
    <SolidColorBrush x:Key="GraphiteRaisedBrush" Color="#C0272F35"/>
    <SolidColorBrush x:Key="AcidLimeBrush" Color="#C6FF4D"/>
    <SolidColorBrush x:Key="ElectricCyanBrush" Color="#72DCE8"/>
    <SolidColorBrush x:Key="FogBrush" Color="#A4ABB3"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="#F5F7F8"/>
    <SolidColorBrush x:Key="InkOnLimeBrush" Color="#10140B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B78"/>
    <SolidColorBrush x:Key="VioletBrush" Color="#B779FF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#404D5961"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#263D4950"/>
    <SolidColorBrush x:Key="MutedSurfaceBrush" Color="#B3191D22"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#C6FF4D"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC857"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C6FF4D" Offset="0"/>
        <GradientStop Color="#9DEBA6" Offset=".5"/>
        <GradientStop Color="#72DCE8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D02B333A"/>
        <GradientStop Color="#B3191D22" Offset=".45"/>
        <GradientStop Color="#CA151B20" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6574858C"/>
        <GradientStop Color="#203A454B" Offset=".5"/>
        <GradientStop Color="#40556B70" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E0273238"/>
        <GradientStop Color="#E8161D22" Offset=".45"/>
        <GradientStop Color="#E010191D" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
