<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Metanoia.App.Controls" xmlns:views="clr-namespace:Metanoia.App.Views" x:Class="Metanoia.App.Views.VideoWorkspaceView">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource GlassCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding SelectedFileName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Row="1" Background="#80080D11" Margin="0,14,0,14">
                        <MediaElement x:Name="VideoMonitor" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed"/>
                        <TextBlock Text="{Binding VideoPreviewStatus}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20" FontSize="10" Foreground="{StaticResource FogBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasVideoPreview}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Visibility="Collapsed" Text="" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20" FontSize="10" Foreground="{StaticResource FogBrush}" IsHitTestVisible="False"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="▶" Style="{StaticResource ToolButton}" Click="OnPlayClick" ToolTip="Reproducir"/>
                            <Button Content="Ⅱ" Style="{StaticResource ToolButton}" Click="OnPauseClick" ToolTip="Pausar" Margin="8,0"/>
                            <Button Content="■" Style="{StaticResource ToolButton}" Click="OnStopClick" ToolTip="Detener"/>
                            <TextBlock x:Name="TimeDisplay" Text="00:00 / 00:00" FontFamily="Consolas" Foreground="{StaticResource ElectricCyanBrush}" VerticalAlignment="Center" Margin="20,0"/>
                        </StackPanel>
                        <Slider Width="100" HorizontalAlignment="Right" Minimum="0" Maximum="1" Value="{Binding Volume, ElementName=VideoMonitor}" ToolTip="Volumen del monitor"/>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="TIMELINE" FontSize="10" Foreground="{StaticResource FogBrush}"/>
                        <TextBlock Text="{Binding VideoDurationSeconds, StringFormat=Duración: {0:0.##} s}" FontSize="10" Foreground="{StaticResource ElectricCyanBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <c:TimelineRuler Grid.Row="1" Duration="{Binding Maximum, ElementName=TimelineSlider}" Height="25"/>
                    <Slider x:Name="TimelineSlider" Grid.Row="1" Margin="0,14,0,0" Minimum="0" Maximum="1" PreviewMouseLeftButtonDown="OnTimelineMouseDown" PreviewMouseLeftButtonUp="OnTimelineMouseUp" PreviewKeyUp="OnTimelineKeyUp" ValueChanged="OnTimelineValueChanged"/>
                    <Border Grid.Row="2" Background="#204D8998" BorderBrush="#5072DCE8" BorderThickness="1" CornerRadius="5" Padding="12,8">
                        <TextBlock Text="{Binding SelectedFileName}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button Content="Marcar entrada" Style="{StaticResource NavButton}" Click="OnMarkIn"/>
                        <Button Content="Marcar salida" Style="{StaticResource NavButton}" Click="OnMarkOut"/>
                        <Button Content="Actualizar monitor" Style="{StaticResource NavButton}" Command="{Binding GenerateVideoProxyCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Column="3" IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}" Style="{StaticResource GlassCard}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Inspector" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="OPERACIÓN" Style="{StaticResource InspectorHeading}"/>
                        <ComboBox ItemsSource="{Binding VideoOperations}" SelectedItem="{Binding SelectedVideoOperation}"/>
                        <TextBlock Text="RECORTE · SEGUNDOS" Style="{StaticResource InspectorHeading}"/>
                        <c:ParameterSlider Label="Entrada" Minimum="0" Maximum="{Binding VideoDurationSeconds}" Value="{Binding VideoTrimStartSeconds, Mode=TwoWay}"/>
                        <c:ParameterSlider Label="Duración · 0 = completa" Minimum="0" Maximum="{Binding VideoDurationSeconds}" Value="{Binding VideoTrimDurationSeconds, Mode=TwoWay}"/>
                        <TextBlock Text="RESOLUCIÓN" Style="{StaticResource InspectorHeading}"/>
                        <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}"/>
                        <c:ParameterSlider Label="CRF · menor = más calidad" Minimum="0" Maximum="51" Value="{Binding Crf, Mode=TwoWay}" Step="1" Snap="True"/>
                        <TextBlock Text="PRESET" Style="{StaticResource InspectorHeading}"/>
                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"/>
                        <Expander Header="Herramientas FFmpeg">
                            <views:FilterToolView Margin="0,12,0,0"/>
                        </Expander>
                        <TextBlock Text="EXPORTACIÓN" Style="{StaticResource InspectorHeading}"/>
                        <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=LostFocus}" FontSize="10" ToolTip="Ruta de salida"/>
                        <Button Content="Cambiar destino" Command="{Binding SelectOutputCommand}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,14"/>
                        <Button Content="Abrir carpeta" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Expander Header="Más formatos · FFmpeg">
                            <views:FormatExportView Margin="0,12,0,0"/>
                        </Expander>
                        <Expander Header="Comando FFmpeg">
                            <StackPanel>
                                <TextBox Text="{Binding CommandDisplay, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8"/>
                                <Button Content="Copiar comando" Command="{Binding CopyCommandCommand}" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Text="{Binding OutputPath}" FontSize="9" Foreground="{StaticResource FogBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                    <Button Content="Exportar video" Command="{Binding ProcessCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
