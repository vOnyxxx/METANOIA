<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Metanoia.App.Controls" xmlns:views="clr-namespace:Metanoia.App.Views" x:Class="Metanoia.App.Views.ImageWorkspaceView">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Button Content="↔" Style="{StaticResource ToolButton}" ToolTip="Mover · arrastrar para desplazar, rueda para zoom" Click="OnMoveTool"/>
            <Button Content="⌗" Style="{StaticResource ToolButton}" ToolTip="Recortar · dibuja una región" Click="OnCropTool"/>
            <Button Content="◐" Style="{StaticResource ToolButton}" ToolTip="Ajustes de color" Click="OnAdjustTool"/>
            <Button Content="◈" Style="{StaticResource ToolButton}" ToolTip="Filtros" Click="OnFilterTool"/>
            <Button Content="↺" Style="{StaticResource ToolButton}" ToolTip="Restablecer vista y ajustes" Click="OnReset"/>
        </StackPanel>
        <Grid Grid.Column="1">
            <Border Style="{StaticResource GlassCard}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{Binding SelectedFileName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ImageTool}" HorizontalAlignment="Right" Foreground="{StaticResource ElectricCyanBrush}" FontSize="11"/>
                    </Grid>
                    <Grid x:Name="ImageViewport" Grid.Row="1" Background="#45080D11" ClipToBounds="True" Margin="0,18,0,14" MouseLeftButtonDown="OnImageDown" MouseMove="OnImageMove" MouseLeftButtonUp="OnImageUp" MouseWheel="OnImageWheel" LostMouseCapture="OnLostCapture">
                        <Image x:Name="SourceImage" Source="{Binding DisplayImage}" Stretch="Uniform" IsHitTestVisible="False" RenderTransformOrigin=".5,.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageScale"/>
                                    <TranslateTransform x:Name="ImagePan"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="CropSelection" Stroke="{StaticResource AcidLimeBrush}" StrokeThickness="1.5" Fill="#25C6FF4D" Visibility="Collapsed" StrokeDashArray="5 3"/>
                        </Canvas>
                        <TextBlock Text="Arrastra una imagen para comenzar" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource FogBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImageLoaded}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Row="2">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Antes / original" IsChecked="{Binding ShowImageOriginal}" Margin="0,0,18,0"/>
                            <TextBlock Text="Rueda: zoom · arrastrar: herramienta activa" FontSize="10" Foreground="{StaticResource FogBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="Actualizar vista" Command="{Binding PreviewImageCommand}" HorizontalAlignment="Right" Style="{StaticResource NavButton}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Column="3" IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}" Style="{StaticResource GlassCard}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Inspector" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="COLOR" Style="{StaticResource InspectorHeading}"/>
                        <c:ParameterSlider x:Name="BrightnessControl" Label="Brillo" Minimum="-1" Maximum="1" Value="{Binding ImageBrightness, Mode=TwoWay}"/>
                        <c:ParameterSlider Label="Contraste" Minimum="0" Maximum="2" Value="{Binding ImageContrast, Mode=TwoWay}"/>
                        <c:ParameterSlider Label="Saturación" Minimum="0" Maximum="3" Value="{Binding ImageSaturation, Mode=TwoWay}"/>
                        <TextBlock Text="FILTRO" Style="{StaticResource InspectorHeading}"/>
                        <ComboBox x:Name="FilterSelector" ItemsSource="{Binding ImageFilters}" SelectedItem="{Binding SelectedImageFilter}"/>
                        <c:ParameterSlider Label="Temperatura · rojo / azul" Minimum="-1" Maximum="1" Value="{Binding ImageTemperature, Mode=TwoWay}"/>
                        <TextBlock Text="GEOMETRÍA" Style="{StaticResource InspectorHeading}"/>
                        <c:ParameterSlider Label="Ancho · 0 = original" Minimum="0" Maximum="8192" Value="{Binding ImageTargetWidth, Mode=TwoWay}" Step="1" Snap="True"/>
                        <CheckBox Content="Aplicar selección de recorte" IsChecked="{Binding ImageCropEnabled}"/>
                        <TextBlock Text="{Binding CropSummary}" Style="{StaticResource SecondaryText}"/>
                        <TextBlock Text="FORMATO" Style="{StaticResource InspectorHeading}"/>
                        <ComboBox ItemsSource="{Binding ImageFormats}" SelectedItem="{Binding SelectedImageFormat}"/>
                        <c:ParameterSlider Label="Calidad" Minimum="1" Maximum="100" Value="{Binding ImageQuality, Mode=TwoWay}" Step="1" Snap="True"/>
                        <Expander Header="Herramientas FFmpeg">
                            <views:FilterToolView Margin="0,12,0,0"/>
                        </Expander>
                        <TextBlock Text="EXPORTACIÓN" Style="{StaticResource InspectorHeading}"/>
                        <TextBox Text="{Binding ImageOutputPath, UpdateSourceTrigger=LostFocus}" FontSize="10" ToolTip="Ruta de salida"/>
                        <Button Content="Cambiar destino" Command="{Binding SelectImageOutputCommand}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,14"/>
                        <Button Content="Abrir carpeta" Command="{Binding OpenImageOutputFolderCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Expander Header="Más formatos · FFmpeg">
                            <views:FormatExportView Margin="0,12,0,0"/>
                        </Expander>
                        <Expander Header="Comando FFmpeg">
                            <StackPanel>
                                <TextBox Text="{Binding ImageCommandDisplay, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8"/>
                                <Button Content="Copiar comando" Command="{Binding CopyImageCommandCommand}" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Text="{Binding ImageOutputPath}" FontSize="9" Foreground="{StaticResource FogBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                    <Button Content="Exportar imagen" Command="{Binding ProcessImageCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
