<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Metanoia.App.Views.HomeView">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="22,12,22,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="230"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                <Border Style="{StaticResource GlassCard}" Width="80" Height="70" Padding="8" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/Logo%20METANOIA.png"/>
                </Border>
                <Image Source="pack://application:,,,/Assets/Wordmark%20METANOIA.png" Width="300" Height="38" Margin="0,18,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="0">
                <Grid>
                    <Rectangle Stroke="{StaticResource AccentGradient}" StrokeThickness="1" StrokeDashArray="5 5" RadiusX="16" RadiusY="16"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="↥" Foreground="{StaticResource AcidLimeBrush}" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Arrastra tus archivos aquí" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,8"/>
                        <TextBlock Text="Imagen, video y audio" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>
                        <Button Content="＋ Nuevo proceso" Command="{Binding SelectFileCommand}" HorizontalAlignment="Center" MinWidth="160" Margin="0,22,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="4">
                <TextBlock Text="Actividad reciente" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <ItemsControl ItemsSource="{Binding QueueItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Width="250" Padding="16,12" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource ElectricCyanBrush}" FontSize="10" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
