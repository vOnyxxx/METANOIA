<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Metanoia.App.Views.PlaceholderWorkspaceView">
    <Grid Margin="32,28,32,32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="8">
            <StackPanel VerticalAlignment="Top">
                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource AcidLimeBrush}" Margin="0,0,0,9">
                    <TextBlock Text="01" Foreground="{StaticResource InkOnLimeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                </Border>
                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource GraphiteRaisedBrush}" Margin="0,0,0,9">
                    <TextBlock Text="02" Foreground="{StaticResource FogBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                </Border>
                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource GraphiteRaisedBrush}" Margin="0,0,0,9">
                    <TextBlock Text="03" Foreground="{StaticResource FogBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                </Border>
                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource GraphiteRaisedBrush}">
                    <TextBlock Text="04" Foreground="{StaticResource FogBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                </Border>
            </StackPanel>
        </Border>
        <StackPanel Grid.Column="2">
            <TextBlock Text="{Binding CurrentSectionTitle}" Style="{StaticResource TitleText}"/>
            <TextBlock Margin="0,6,0,20" Text="{Binding CurrentSectionDescription}" Style="{StaticResource SecondaryText}"/>
            <Border Style="{StaticResource GlassCard}" MinHeight="430" BorderBrush="#553A424C">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="VISTA DE TRABAJO" Foreground="{StaticResource ElectricCyanBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <Border HorizontalAlignment="Right" Background="#22C6FF4D" CornerRadius="10" Padding="10,5">
                            <TextBlock Text="PREPARADO · PRÓXIMA FASE" Foreground="{StaticResource AcidLimeBrush}" FontSize="10"/>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,20" Background="#780A0C0F" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="METANOIA" Foreground="{StaticResource AcidLimeBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Margin="0,10,0,0" Text="Importa un archivo para detectar sus propiedades" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Margin="0,8,0,18" Text="La edición se incorporará en su versión correspondiente sin simular herramientas que todavía no existen." Style="{StaticResource SecondaryText}" TextAlignment="Center"/>
                            <Button Content="Abrir archivo" Command="{Binding SelectFileCommand}" MinWidth="126" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{Binding UpcomingTools}" Style="{StaticResource TechnicalText}" TextAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
        <StackPanel Grid.Column="4">
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="ARCHIVO DETECTADO" Foreground="{StaticResource AcidLimeBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,10,0,0" Text="{Binding SelectedFileName}" Style="{StaticResource SectionTitleText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Margin="0,12,0,0" Text="{Binding MediaSummary}" Style="{StaticResource SecondaryText}"/>
                    <TextBlock Margin="0,12,0,0" Text="{Binding TechnicalSummary}" Style="{StaticResource TechnicalText}"/>
                </StackPanel>
            </Border>
            <Border Margin="0,18,0,0" Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="AVANZADO · FFMPEG" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock Margin="0,8,0,0" Text="El comando aparecerá cuando las operaciones de este workspace se implementen y validen." Style="{StaticResource SecondaryText}"/>
                    <TextBox Margin="0,14,0,0" Text="Comando no disponible en v0.2" IsReadOnly="True" MinHeight="86" Foreground="{StaticResource ElectricCyanBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
