<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:Metanoia.Core.Models;assembly=Metanoia.Core" x:Class="Metanoia.App.Views.AdvancedWorkspaceView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Avanzado" FontSize="30" FontWeight="Bold"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#18213A52" BorderBrush="#4656C8FF" BorderThickness="1" CornerRadius="12" Padding="14,9" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource ElectricCyanBrush}" Margin="0,0,9,0"/>
                        <TextBlock Text="MODO SEGURO · SIN SHELL" Foreground="{StaticResource ElectricCyanBrush}" FontWeight="SemiBold" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" MinWidth="520"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="0.75*" MinWidth="330"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelCard}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="ARGUMENTOS ADICIONALES" Foreground="{StaticResource ElectricCyanBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,7,0,0" Text="Edición validada" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,5,0,16" Text="Solo se aceptan opciones de una lista cerrada. La entrada, la salida y el ejecutable permanecen protegidos." Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                        <TextBox xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" Text="{Binding AdvancedArgumentsText, UpdateSourceTrigger=PropertyChanged}" MinHeight="112" AcceptsReturn="False" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" automation:AutomationProperties.Name="Argumentos FFmpeg avanzados"/>
                        <Border Margin="0,12,0,0" Padding="13,11" CornerRadius="9" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#181E2A36"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreAdvancedArgumentsValid}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding AdvancedValidationMessage}" TextWrapping="Wrap" FontSize="11"/>
                        </Border>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="Validar y activar" Command="{Binding ValidateAdvancedArgumentsCommand}"/>
                            <Button Margin="9,0,0,0" Content="Limpiar" Style="{StaticResource SecondaryButton}" Command="{Binding ClearAdvancedArgumentsCommand}"/>
                        </WrapPanel>
                        <Border Margin="0,18,0,0" Padding="14" CornerRadius="10" Background="#AA0A101A" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="OPCIONES PERMITIDAS" Foreground="{StaticResource FogBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,7,0,0" Text="-metadata · -movflags · -pix_fmt · -threads · -map_metadata · -map_chapters · colorimetría · disposiciones · -shortest · -vn · -an · -sn · -dn" Style="{StaticResource TechnicalText}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="PRESETS LOCALES" Foreground="{StaticResource VioletBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,7,0,14" Text="Guarda configuraciones verificadas" FontSize="18" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding AdvancedPresetName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nombre del preset"/>
                        <Button Margin="0,9,0,14" Content="Guardar preset actual" Command="{Binding SaveAdvancedPresetCommand}"/>
                        <TextBlock Text="No hay presets guardados todavía.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AdvancedPresets.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding AdvancedPresets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#AA0B1320" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,9">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,4,0,0" Text="{Binding Arguments}" Style="{StaticResource TechnicalText}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,3,0,8" Text="{Binding CreatedAt}" Style="{StaticResource SecondaryText}" FontSize="9"/>
                                            <WrapPanel>
                                                <Button Content="Cargar" Style="{StaticResource CompactButton}" Command="{Binding DataContext.LoadAdvancedPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <Button Margin="7,0,0,0" Content="Eliminar" Style="{StaticResource DangerButton}" Command="{Binding DataContext.DeleteAdvancedPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="20,17,20,12">
                            <StackPanel>
                                <TextBlock Text="HISTORIAL PERSISTENTE" Foreground="{StaticResource AcidLimeBrush}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,4,0,0" Text="{Binding HistorySummary}" Style="{StaticResource SecondaryText}" FontSize="11"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Content="Limpiar finalizados" Style="{StaticResource SecondaryButton}" Command="{Binding ClearCompletedHistoryCommand}"/>
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding HistoryItems}" Margin="12,0,12,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#AA0B1320" CornerRadius="8" Padding="11" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding OutputName}" Style="{StaticResource SecondaryText}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="12,0" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource ElectricCyanBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CreatedAt}" Style="{StaticResource SecondaryText}" FontSize="9"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="×" Width="32" Style="{StaticResource DangerButton}" Command="{Binding DataContext.RemoveHistoryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="LOG DE SESIÓN" Foreground="{StaticResource ElectricCyanBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,4,0,0" Text="Diagnóstico legible y copiable" Style="{StaticResource SecondaryText}" FontSize="11"/>
                        </StackPanel>
                        <TextBox Grid.Row="2" Text="{Binding SessionLogText}" IsReadOnly="True" MinHeight="210" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10"/>
                        <Button Grid.Row="4" Content="Copiar log" Style="{StaticResource SecondaryButton}" Command="{Binding CopySessionLogCommand}" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
