<Window x:Class="Metanoia.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="METANOIA · FFmpeg vertical slice"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ObsidianBrush}"
        Foreground="{StaticResource WhiteBrush}"
        FontFamily="{StaticResource InterfaceFont}"
        AllowDrop="True"
        PreviewDragOver="OnPreviewDragOver"
        Drop="OnDrop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#E6191D22"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="10" ClipToBounds="True" Background="{StaticResource ObsidianBrush}">
                        <Image Source="pack://application:,,,/Assets/Logo%20METANOIA.png"
                               Stretch="UniformToFill"
                               automation:AutomationProperties.Name="Logo de METANOIA" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="METANOIA" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Transformación multimedia · v0.1.1" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#332A3038" CornerRadius="14" Padding="14,6" Margin="4,0">
                        <TextBlock Text="Inicio" Foreground="{StaticResource AcidLimeBrush}" FontSize="12" />
                    </Border>
                    <Border Background="Transparent" CornerRadius="14" Padding="14,6" Margin="4,0">
                        <TextBlock Text="Vertical slice técnico" Style="{StaticResource SecondaryText}" />
                    </Border>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="#1F72DCE8"
                        BorderBrush="#5572DCE8"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,7"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource ElectricCyanBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ToolStatusText}" Foreground="{StaticResource ElectricCyanBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,28,32,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" MinWidth="520" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="0.9*" MinWidth="390" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="¿Qué quieres transformar?" Style="{StaticResource TitleText}" />
                    <TextBlock Margin="0,6,0,20"
                               Text="Importa un video, revisa sus propiedades y ejecuta una conversión MP4/H.264 verificable."
                               Style="{StaticResource SecondaryText}" />

                    <Border Style="{StaticResource PanelCard}"
                            BorderBrush="#6672DCE8"
                            Padding="26,24"
                            automation:AutomationProperties.Name="Zona para abrir o arrastrar video">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="ARRASTRA TU VIDEO AQUÍ" Foreground="{StaticResource ElectricCyanBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Grid.Row="1" Margin="0,10,0,18" Text="También puedes abrir MP4, MOV, MKV, AVI, WebM o M4V" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
                            <Button Grid.Row="2" MinWidth="116" Content="Abrir video" Command="{Binding SelectFileCommand}" HorizontalAlignment="Center" automation:AutomationProperties.Name="Abrir video" />
                        </Grid>
                    </Border>

                    <Border Margin="0,18,0,0" Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ANÁLISIS · FFPROBE" Foreground="{StaticResource ElectricCyanBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0" Text="{Binding SelectedFileName}" Style="{StaticResource SectionTitleText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="#22C6FF4D"
                                        CornerRadius="10"
                                        Padding="10,5"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="VIDEO · MP4/H.264" Foreground="{StaticResource AcidLimeBrush}" FontSize="10" />
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Margin="0,15,0,5" Text="{Binding MediaSummary}" Style="{StaticResource SecondaryText}" />
                            <TextBlock Grid.Row="2" Margin="0,3,0,0" Text="{Binding TechnicalSummary}" Style="{StaticResource TechnicalText}" />
                        </Grid>
                    </Border>

                    <Border Margin="0,18,0,0" Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="AVANZADO · FFMPEG" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Margin="0,5,0,12" Text="Vista de solo lectura. La ejecución usa ArgumentList, nunca esta cadena." Style="{StaticResource SecondaryText}" />
                            <TextBox Text="{Binding CommandDisplay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="92"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="11"
                                     Foreground="{StaticResource ElectricCyanBrush}"
                                     automation:AutomationProperties.Name="Comando FFmpeg visible" />
                            <Button Margin="0,12,0,0"
                                    Content="Copiar comando"
                                    Command="{Binding CopyCommandCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="CONFIGURACIÓN" Foreground="{StaticResource AcidLimeBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Margin="0,7,0,18" Text="Video a MP4 · H.264 + AAC" Style="{StaticResource SectionTitleText}" />

                            <TextBlock Text="Resolución" Style="{StaticResource SecondaryText}" />
                            <ComboBox Margin="0,6,0,14" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" />

                            <TextBlock Text="Calidad CRF · 0–51 (menor = más calidad)" Style="{StaticResource SecondaryText}" />
                            <TextBox Margin="0,6,0,14" Text="{Binding Crf, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="CRF" />

                            <TextBlock Text="Preset x264" Style="{StaticResource SecondaryText}" />
                            <ComboBox Margin="0,6,0,14" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" />

                            <TextBlock Text="Archivo de salida" Style="{StaticResource SecondaryText}" />
                            <TextBox Margin="0,6,0,8" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="50" automation:AutomationProperties.Name="Ruta de salida" />
                            <Button Content="Elegir salida" Command="{Binding SelectOutputCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,18,0,0" Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PROCESAMIENTO" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" Foreground="{StaticResource ElectricCyanBrush}" />
                            </Grid>
                            <ProgressBar Margin="0,14,0,12" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" MinHeight="34" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Procesar" Command="{Binding ProcessCommand}" automation:AutomationProperties.Name="Procesar video" />
                                <Button Grid.Column="2" Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" automation:AutomationProperties.Name="Cancelar proceso" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,18,0,0" Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="RESULTADO" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Margin="0,9,0,12" Text="{Binding ResultMessage}" Style="{StaticResource SecondaryText}" />
                            <Button Content="Abrir carpeta" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#E6191D22" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="28,0">
            <Grid>
                <TextBlock Text="{Binding QueueSummary}" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="v0.1.1 · proceso externo seguro · sin shell" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AcidLimeBrush}" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
