<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Metanoia.App.Controls.ParameterSlider" x:Name="Root">
    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="72"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label, ElementName=Root}" Foreground="{StaticResource FogBrush}" FontSize="11" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" MinHeight="27" Padding="5,3" TextAlignment="Right" FontSize="11" ToolTip="Escribe un valor y pulsa Tab para aplicarlo"/>
        <Slider xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" Grid.Row="1" Grid.ColumnSpan="2" Minimum="{Binding Minimum, ElementName=Root}" Maximum="{Binding Maximum, ElementName=Root}" Value="{Binding Value, ElementName=Root, Mode=TwoWay}" SmallChange="{Binding Step, ElementName=Root}" TickFrequency="{Binding Step, ElementName=Root}" IsSnapToTickEnabled="{Binding Snap, ElementName=Root}" automation:AutomationProperties.Name="{Binding Label, ElementName=Root}"/>
    </Grid>
</UserControl>
